# =============================================================================
# Inkling-Small-NVFP4 on 2x DGX Spark (GB10 / SM121) — PINNED KNOWN-GOOD CONFIG
#
# Measured with this exact config on a clean box (2026-08-18):
#   c1 decode : 43.0 tok/s median, 60.07 tok/s peak, step 64.3-66.2ms
#   c4        : 94.1 tok/s aggregate  (best aggregate point)
#   context   : 262,144 max, verified serving 234,221 prompt tokens
#   coherence : clean on /v1/chat/completions (0 repeated 8-grams, natural stop)
#
# Every value below is load-bearing. Read DEPLOY-README.md before changing any of
# them — several have non-obvious floors that will refuse to boot or wedge the host.
# =============================================================================

# ---- topology (EDIT THESE for your hosts) -----------------------------------
WORKER_HOST=<user>@<worker-ip>
WORKER_DIR=${HOME}/inkling-2-sparks
MASTER_ADDR=<head-ip>
MASTER_PORT=25100
VLLM_HOST=<head-ip>
VLLM_HOST_IP=<head-ip>
VLLM_PORT=8000

# ---- RoCE / NCCL: must name the ACTIVE 200G port, not the idle one ----------
# Verify with: ibdev2netdev   (pick the PORT_ACTIVE device + its netdev)
# The netdev must have MTU 9000. Getting this wrong silently costs throughput.
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
WORKER_NCCL_IB_HCA=rocep1s0f1
WORKER_NCCL_SOCKET_IFNAME=enp1s0f1np1

# ---- image (PINNED) ---------------------------------------------------------
# Built image ID: sha256:d734208f04e1ca9b13ace21dacf0916945aacbb380e3d38124dbdf8825d6a6b3
# Base:          vllm/vllm-openai:nightly-65b7662d3fcb773afaf751ab29ac6960a0cf011d
#                @sha256:cec2df507519b5a2c4d9870524f86a2a100fae79cb689d1ce11f3d4da2f4ffad
# vLLM commit:   65b7662d3fcb773afaf751ab29ac6960a0cf011d
# FA commit:     a80c4d7b5af32426002c42028a66a78408c273b2
# MTP patch:     0841fed141e9cb18e4464c2b4ec74881cdd90654
INKLING_VLLM_IMAGE=local/inkling-vllm:v38-20260817

MODEL_ROOT=${HOME}/models
INKLING_MODEL=/models/Inkling-Small-NVFP4
SERVED_MODEL_NAME=inkling-small

# ---- parallelism ------------------------------------------------------------
PARALLEL_MODE=tp_pp
TENSOR_PARALLEL_SIZE=2
PIPELINE_PARALLEL_SIZE=1
ENABLE_EXPERT_PARALLEL=0

# ---- memory: THESE HAVE HARD FLOORS ----------------------------------------
# KV_CACHE_MEMORY_BYTES floor is ~18.5GB. At 16GB the engine REFUSES to boot:
#   "max seq len (262144) needs 17.3 GiB KV, larger than available 14.9 GiB".
# 20GB is the proven value. Do not lower it without also lowering MAX_MODEL_LEN.
GPU_MEMORY_UTILIZATION=0.88
KV_CACHE_DTYPE=auto
KV_CACHE_MEMORY_BYTES=20000000000
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
BLOCK_SIZE=16
ENABLE_PREFIX_CACHING=1

# ---- speculative decoding ---------------------------------------------------
# MTP3 is optimal. MTP4 was measured: acceptance rises (E 3.0-3.4) but step time
# goes 69ms -> 85-137ms because MTP-N verifies N+1 tokens and the MoE reads the
# UNION of their top-6 experts. Net loss. Do not "improve" this to 4.
MTP_NUM_TOKENS=3

# ---- kernels ----------------------------------------------------------------
# flashinfer_cutlass is the ONLY working MoE backend on SM121. Measured/rejected:
#   flashinfer_trtllm -> refuses to boot (unquantized sink path unsupported)
#   flashinfer_b12x   -> CuTeDSL JIT storm, WEDGES the node
#   flashinfer_cutedsl-> JIT storm
#   marlin            -> boots, only +1.5%
MOE_BACKEND=flashinfer_cutlass
INKLING_SINK_NVFP4=1
INKLING_SINK_FP8=1
INKLING_MOE_SPLIT=0
LAMPORT_RS_SCONV=0

# ---- diagnostics ------------------------------------------------------------
# INKLING_DECOMP=1 writes per-step breakdown to /tmp/decomp_v24.log inside the
# container (fwd/logits/draft/reject/book/total). Cheap; leave on.
INKLING_DECOMP=1

# ---- host protection --------------------------------------------------------
# The container is oom_score_adj'd so the host control plane survives if a
# unified-memory experiment oversubscribes RAM.
OOM_SCORE_ADJ=250
